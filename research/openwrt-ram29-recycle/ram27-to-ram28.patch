+    if(rc) { c->netdev=NULL;free_netdev(dev);return rc; }
+    dev_info(c->dev,"c80wlan0 registered; Linux IPv4 stack, MTU%u, %u unique TX buffers per boot\n",
+             C80_NET_MTU,C80_NET_TX_N);
