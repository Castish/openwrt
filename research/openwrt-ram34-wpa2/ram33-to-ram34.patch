+    c80_u32 tx_eapol,tx_encrypted,tx_blocked;
+    c80_u8 gtk_key[16],ptk_key[16],assoc_rsn[24];
+    c80_u32 assoc_rsn_bytes;
+    c80_u64 rx_pn[17];
+};
+static inline void c80_secret_clear(void *p,c80_u32 n)
+{ volatile c80_u8 *v=p;while(n--) *v++=0; }
