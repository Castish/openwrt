+// SPDX-License-Identifier: GPL-2.0-only
+// Minimal experimental RAM-boot description, not a complete OpenWrt board DTS.
+/dts-v1/;
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+    model = "TP-Link Archer C80 v1 RU experimental RAM bring-up";
+    compatible = "tplink,archer-c80-v1", "mediatek,mt7626";
+    #address-cells = <1>;
+    #size-cells = <1>;
+    interrupt-parent = <&gic>;
+
+    aliases { serial0 = &uart0; };
+    chosen {
+        stdout-path = "serial0:115200n8";
+        linux,usable-memory-range = <0x40200000 0x01e00000>;
+        bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x11002000 loglevel=8 rdinit=/init panic=0 clk_ignore_unused";
+    };
+
+    memory@40000000 {
+        device_type = "memory";
+        reg = <0x40000000 0x02000000>;
+    };
+
+    // Preserve the factory 2MiB CONNSYS EMI window before any Wi-Fi setup.
+    reserved-memory {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges;
+        conn_emi: memory@40000000 {
+            reg = <0x40000000 0x00200000>;
+            no-map;
+        };
+    };
+
+    cpus {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        cpu@0 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a7";
+            reg = <0>;
+        };
+    };
+
+    uart_clk: uart-clock {
+        compatible = "fixed-clock";
+        #clock-cells = <0>;
+        clock-frequency = <40000000>;
+    };
+
+    timer {
+        compatible = "arm,armv7-timer";
+        interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_HIGH)>,
+                     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_HIGH)>,
+                     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_HIGH)>,
+                     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_HIGH)>;
+        clock-frequency = <20000000>;
+    };
+
+    soc {
+        compatible = "simple-bus";
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges;
+
+        restart-controller@10212000 {
+            compatible = "tplink,c80-mt7626-restart";
+            reg = <0x10212000 0x18>;
+        };
+
