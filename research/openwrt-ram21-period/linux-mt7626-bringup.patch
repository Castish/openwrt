+        offset=16+16*!!(group&8)+16*!!(group&1)+8*!!(group&2)+24*!!(group&4);
+        if(p[6]&0x40) offset+=2;
+        if(offset>total) { r->radio_rx_bad=3; return C80_RADIO_RX_BAD; }
+        if(p[6]&0x80) { ++r->radio_rx_translated; goto recycle; }
+        ++r->radio_raw_frames;
