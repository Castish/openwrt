+        if(budget==C80_RX_N) { ++r->rx0_budget_yields; break; }
+        index=r->rx_next[0];
+        if(index>=C80_RX_N) { r->radio_rx_bad=4; return C80_RADIO_RX_BAD; }
+        ctrl=io->pool->rx[0][index].ctrl;
