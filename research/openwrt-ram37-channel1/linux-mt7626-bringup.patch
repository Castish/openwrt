+ * ring. Reuse requires the prior descriptor to be DDONE, DMA/CPU indices to
+ * agree, and the matching command reply to have been consumed. A timeout never
+ * unlocks a buffer and no live index is reset. All device ownership checks
+ * happen before writing either the payload or the descriptor. */
+static c80_u32 c80_command_reuse(struct c80_io *io,struct c80_result *r,
+                                c80_u32 bytes,c80_u8 **packet,c80_u32 *slot)
