+        if(now<start) r->nvm_wait_clock_backwards|=1;
+    } else if(r->phase==22) {
+        r->nvm_get_wait_us=elapsed; r->nvm_get_polls=polls;
+        if(now<start) r->nvm_wait_clock_backwards|=2;
