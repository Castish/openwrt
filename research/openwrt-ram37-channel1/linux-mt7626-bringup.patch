+static ssize_t run_store(struct kobject *kobj,struct kobj_attribute *attr,
+                          const char *buf,size_t count)
+{
+    struct c80_linux *c=c80_live;
+    const struct firmware *fw[6]={}; struct c80_blob blobs[6];
+    bool notify_stop=false;
+    unsigned int i; int rc;
+    if(!c || !sysfs_streq(buf,"1")) return -EINVAL;
+    if(!mutex_trylock(&c->lock)) return -EBUSY;
+    if(c->ran) { mutex_unlock(&c->lock); return -EALREADY; }
+    c->ran=true;
+    for(i=0;i<6;++i) {
+        rc=request_firmware_direct(&fw[i],c80_filenames[i],c->dev);
+        if(rc) { c->rc=rc; goto done; }
+        if(fw[i]->size>UINT_MAX) { c->rc=-EFBIG; goto done; }
+        blobs[i].data=fw[i]->data; blobs[i].bytes=fw[i]->size;
+    }
+    c->pool=dma_alloc_coherent(c->dev,sizeof(*c->pool),&c->dma,GFP_KERNEL);
+    if(!c->pool) { c->rc=-ENOMEM; goto done; }
+    memset(c->pool,0,sizeof(*c->pool));
+    if(upper_32_bits(c->dma) || c->dma<0x40200000 ||
+       c->dma+sizeof(*c->pool)>0x42000000 || (c->dma&255)) {
+        c->rc=-ERANGE; goto done;
+    }
+    c->io.pool=c->pool; c->io.dma_base=(c80_u32)c->dma;
+    c->peer_address=c80_current_peer(&c->io);
+    c->peer_rsn=c->result.security.assoc_rsn;
+    c->rc=c80_run(&c->io,blobs,&c->result);
+done:
+    if(c->pool) {
+        /* Active data cells may be reused only after DDONE AND TX-free.
+         * Stopping does not prove every firmware/shared allocation drained.
+         * After ANY submission keep the complete pool unchanged after this
+         * run until system reset, even when MCU/WPDMA stop checks passed.
+         * Critical/failed DMA stop also pins every allocation as before. */
+        if(c->result.auth_submitted || c->result.assoc_submitted || c->result.diag_submissions || c->result.net.submitted || c->result.critical ||
+           (c->result.dma_started && !c->result.dma_idle)) c->retained=true;
+        else {
+            memzero_explicit(c->pool,sizeof(*c->pool));
+            dma_free_coherent(c->dev,sizeof(*c->pool),c->pool,c->dma); c->pool=NULL;
+        }
+    }
+    for(i=0;i<6;++i) release_firmware(fw[i]);
+    c->finished=true;
+    if(c->cfg) {
+        notify_stop=READ_ONCE(c->cfg->active) && !READ_ONCE(c->net_stop_requested);
+        c80_cfg_keys_finish(c->cfg);
+        c->cfg->stop_rc=c->result.critical || c->result.cleanup ||
+            (c->result.dma_started && !c->result.dma_idle)?-EIO:0;
+        WRITE_ONCE(c->cfg->active,false);WRITE_ONCE(c->cfg->finished,true);
+        complete_all(&c->cfg->started);complete_all(&c->cfg->stopped);
+    }
+    dev_info(c->dev,"MCU Linux netdev test result=%d critical=%u; fresh boot required\n",
+             c->rc,c->result.critical);
+    mutex_unlock(&c->lock);
+    if(notify_stop) cfg80211_stop_iface(c->cfg->wdev.wiphy,&c->cfg->wdev,GFP_KERNEL);
+    return count;
+}
