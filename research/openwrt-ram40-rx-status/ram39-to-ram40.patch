+/* RXD SecMode describes the WCID/key lookup, not whether this MPDU has the
+ * Protected bit. An existing CCMP WCID must still accept the same peer's
+ * ordinary unprotected auth/disassoc/deauth during a non-PMF reconnect.
+ * The old uniform data gate discarded these before the session state machine.
+ * Waive only mode0/4 and CipherMis for this tightly bounded case. Never waive
+ * FCS, ICV, MIC, length/translation errors, Protected/Order, fragmentation,
+ * peer/BSSID checks or the session parser's algorithm/RSN/body validation. */
+static int c80_management_status(struct c80_io *io,struct c80_result *r,
+                                  const c80_u8 *v,const c80_u8 *p,c80_u32 bytes)
+{
+    struct c80_management_filter *f=&r->management_filter;
+    c80_u32 dw=c80_get32(v+8),mode=(dw>>12)&15,flags=(dw>>16)&1023;
+    c80_u32 fc=bytes>=2?c80_get16(p):0,sub=(fc>>4)&15,i,peer=0;
+    int legacy=!(v[10]&0x9f) && !(v[11]&3) && !(v[9]&0xf0);
+    if(!io->session_test) return 1;
+    ++f->checked;
+    if(bytes>=24 && !(fc&0xc70f) && !(c80_get16(p+22)&15) &&
+       (sub==0 || sub==2 || sub==10 || sub==11 || sub==12) &&
+       c80_mac_equal(p+4,io->pool->nvm_payload+8) &&
+       c80_mac_equal(p+16,io->pool->nvm_payload+8) &&
+       c80_mac_equal(p+10,c80_current_peer(io))) peer=1;
+    if(!legacy) ++f->legacy_reject;
+    if(legacy || (peer && io->wpa2_test && r->phase==37 &&
+                  r->session.started && r->session.sta_live && r->security.ptk &&
+                  (mode==0 || mode==4) && !(flags&~4u))) {
+        ++f->accepted;
+        if(!legacy) {
+            ++f->peer_plaintext;
+            if(!f->first_peer_plain_valid) {
+                f->first_peer_plain_valid=1;f->first_peer_plain_rxd2=dw;
+                f->first_peer_plain_fc=fc;
+            }
+        }
+        return 1;
+    }
+    ++f->rejected;++r->session.bad;++f->modes[mode];
+    for(i=0;i<10;++i) if(flags&(1u<<i)) ++f->status_bits[i];
+    if(peer) {
+        ++f->peer_rejected_subtype[sub];
+        if(!f->first_peer_reject_valid) {
+            f->first_peer_reject_valid=1;f->first_peer_reject_rxd2=dw;
+            f->first_peer_reject_fc=fc;
+        }
+    }
+    return 0;
+}
