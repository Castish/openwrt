+static c80_u32 c80_initial_ownership(struct c80_io *io,struct c80_result *r)
+{
+    c80_u64 start,now;int acquired;
+    r->own_before=r->own_last=c80_read(io,C80_OWN);
+    if(r->own_before==0xffffffffu) return C80_OWN_TIMEOUT;
+    if(r->own_before&1) {
+        /* RAM41 reaches the bootstrap marker with real sub-tick waits, but
+         * its one ownership request was not acknowledged on hardware. Allow
+         * a bounded settling interval before that same command. No retries,
+         * timeout extension, RMW or fabricated ownership/completion state.
+         * The firmware's actual minimum requirement is not established.
+         */
+        start=io->time_us(io->context);
+        io->delay_us(io->context,C80_OWN_SETTLE_US);
+        now=io->time_us(io->context);
+        if(now<start) return C80_BAD_TIMER;
+        r->boot_settle_us=now-start;
+        if(r->boot_settle_us<C80_OWN_SETTLE_US) return C80_BAD_TIMER;
+        r->boot_settled=1;
+        c80_write(io,C80_OWN,2);r->own_sent=1;
+    }
+    start=io->time_us(io->context);
+    acquired=c80_poll(io,C80_OWN,1,0,2000000,&r->own_last);
+    now=io->time_us(io->context);
+    if(now>=start) r->boot_own_wait_us=now-start;
+    r->boot_own_confirmed=!!acquired;
+    return acquired?0:C80_OWN_TIMEOUT;
+}
